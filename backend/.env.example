# --- Database ---
# Full PostgreSQL connection string. The async (asyncpg) URL is derived automatically.
ADMIN_DB_CONNECTION=postgresql://user:password@localhost:5432/erp

# --- Default admin user (seeded on first startup) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Security ---
# JWT signing key. REQUIRED — the app will not start without it.
# Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generate-a-long-random-secret
