# --- Database ---
# Full PostgreSQL connection string. The async (asyncpg) URL is derived automatically.
ADMIN_DB_CONNECTION=postgresql://user:password@localhost:5432/carzinomax

# --- Default admin user (seeded on first startup) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Security ---
# JWT signing key. REQUIRED — the app will not start without it.
# Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generate-a-long-random-secret

# --- Scheduler ---
# Paycheck calculation timespot (cron expression). Defaults to the 1st of every month at midnight ("0 0 1 * *").
PAYCHECK_CALCULATE_TIMESPOT="0 0 1 * *"

# --- GitHub sync ---
# Optional personal access token (fine-grained: Metadata read + Contents read on the tracked repos).
# Without it only PUBLIC repos can be synced and GitHub allows 60 requests/hour per IP; with it 5000/hour.
# REQUIRED for private repos. Never commit a real token.
GITHUB_TOKEN=""
# Cron for the stars/downloads sync job ("github_sync"). Defaults to every 6 hours.
# An invalid value is logged at startup and the job is skipped. Day-of-week counts from Monday = 0.
GITHUB_SYNC_CRON="0 */6 * * *"

# --- LLM Integration ---
# LLM_TYPE: "remote" (hosted provider) or "local" (self-hosted server). Defaults to "remote".
# LLM_MODEL uses litellm naming: "<provider>/<model>", e.g.
#   remote: "anthropic/claude-sonnet-5", "openai/gpt-5", "gemini/gemini-2.5-pro"
#   local:  "ollama/llama3.2-vision" (Ollama), "openai/<model>" (any OpenAI-compatible server)
# LLM_API_BASE is only used when LLM_TYPE="local", e.g. "http://127.0.0.1:11434" or "http://127.0.0.1:1234/v1".
# LLM_API_KEY is the provider API key. Local servers usually ignore it, but some need a dummy value.
# The model must accept image input (vision): receipts attached in the chat are sent to it as images, there is no text-only fallback.
LLM_TYPE="remote"
LLM_API_BASE=""
LLM_MODEL=""
LLM_API_KEY=""

# --- Outgoing mail (SMTP) ---
# Used by the scheduler to send the project summary. SMTP_HOSTNAME, SMTP_PORT, MAIL_FROM and SMTP_PASSWORD are
# REQUIRED, the app will not start without them. For Gmail: hostname smtp.gmail.com, port 587 (STARTTLS) or 465 (SSL),
# MAIL_FROM = the Gmail address (used both as SMTP login and as sender), password = a 16-char App Password from https://myaccount.google.com/apppasswords
# (needs 2-Step Verification on the account). Never commit a real password.
SMTP_HOSTNAME=
SMTP_PORT=
SMTP_PASSWORD=
MAIL_FROM=

# --- Project summary mail schedule ---
# When the (planned) summary_mail job runs: it will email an LLM-written project summary, through the SMTP settings
# above, to every ACTIVE user whose "Receive project summary email" (send_summary) toggle is on in Users & Access.
# SUMMARY_SEND_TIME and SUMMARY_SEND_FREQ are REQUIRED, the app will not start without them.
# SUMMARY_SEND_TIME: hour of day 0-23 in the server's local time zone (fires at minute 0).
# SUMMARY_SEND_FREQ: day, week or month.
# SUMMARY_SEND_WEEKDAY: 0-6 counted from Monday = 0. REQUIRED when FREQ=week, ignored otherwise.
# SUMMARY_SEND_MONTHDAY: 1-31. REQUIRED when FREQ=month, ignored otherwise; 29-31 are skipped in shorter months.
SUMMARY_SEND_TIME=
SUMMARY_SEND_FREQ=
SUMMARY_SEND_WEEKDAY=
SUMMARY_SEND_MONTHDAY=

# --- Chat attachments ---
# Files attached in the chat are stored on disk under <UPLOAD_DIR>/<user_id>/<uuid>.<ext> (no database table, kept forever).
# UPLOAD_DIR is relative to backend/ unless absolute. UPLOAD_MAX_BYTES is the limit per file (default 10 MB);
# keep the reverse proxy body limit above it (docker-compose.yml sets nginx client_max_body_size 12m).
UPLOAD_DIR="uploads"
UPLOAD_MAX_BYTES=10485760
