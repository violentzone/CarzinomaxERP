# --- Database ---
# Full PostgreSQL connection string. The async (asyncpg) URL is derived automatically.
ADMIN_DB_CONNECTION=postgresql://user:password@localhost:5432/carzinomax

# --- Default admin user (seeded on first startup) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Security ---
# JWT signing key. REQUIRED — the app will not start without it.
# Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generate-a-long-random-secret

# --- Scheduler ---
# Paycheck calculation timespot (cron expression). Defaults to the 1st of every month at midnight ("0 0 1 * *").
PAYCHECK_CALCULATE_TIMESPOT="0 0 1 * *"

# --- GitHub sync ---
# Optional personal access token (fine-grained: Metadata read + Contents read on the tracked repos).
# Without it only PUBLIC repos can be synced and GitHub allows 60 requests/hour per IP; with it 5000/hour.
# REQUIRED for private repos. Never commit a real token.
GITHUB_TOKEN=""
# Cron for the stars/downloads sync job ("github_sync"). Defaults to every 6 hours.
# An invalid value is logged at startup and the job is skipped. Day-of-week counts from Monday = 0.
GITHUB_SYNC_CRON="0 */6 * * *"

# --- LLM Integration ---
# LLM_TYPE: "remote" (hosted provider) or "local" (self-hosted server). Defaults to "remote".
# LLM_MODEL uses litellm naming: "<provider>/<model>", e.g.
#   remote: "anthropic/claude-sonnet-5", "openai/gpt-5", "gemini/gemini-2.5-pro"
#   local:  "ollama/llama3" (Ollama), "openai/<model>" (any OpenAI-compatible server)
# LLM_API_BASE is only used when LLM_TYPE="local", e.g. "http://127.0.0.1:11434" or "http://127.0.0.1:1234/v1".
# LLM_API_KEY is the provider API key. Local servers usually ignore it, but some need a dummy value.
LLM_TYPE="remote"
LLM_API_BASE=""
LLM_MODEL=""
LLM_API_KEY=""
