# Ports of different service
# Also read outside Docker: BACKEND_PORT by `python -m app.main` and the Vite dev proxy (frontend/vite.config.js),
# DB_PORT by backend/.env through ${DB_PORT:-5432} in ADMIN_DB_CONNECTION
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database administrator: the account docker-compose.yml creates the db service with, and the one `alembic upgrade head`
# connects as on localhost:DB_PORT (backend/migration/env.py). Left empty, compose uses carzinomax / carzinomax / carzinomax
# and Alembic falls back to ADMIN_DB_CONNECTION in backend/.env (also when only one of user / password is set), which works on the
# host only if that URL is an administrator. Postgres keeps the account its volume was first initialised with: after changing these
# run `docker compose down -v` (deletes the data). DB_PORT must not collide with another Postgres on this machine. Never commit a real password.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
