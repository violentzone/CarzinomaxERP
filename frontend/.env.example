# Base URL for the Carzinomax DEV API.
# In dev this stays as `/api/v1` — Vite proxies `/api` to http://localhost:<BACKEND_PORT>
# (BACKEND_PORT from the repo-root .env, default 8000; see vite.config.js).
# For a production build, point this at your deployed API,
# e.g. VITE_API_BASE_URL=https://erp.example.com/api/v1
VITE_API_BASE_URL=/api/v1
